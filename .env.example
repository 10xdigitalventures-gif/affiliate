# ---- Database ----
DATABASE_URL="postgresql://affiliate:affiliate@localhost:5432/affiliate?schema=public"

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- Auth ----
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=900          # 15 minutes (seconds)
JWT_REFRESH_TTL=604800      # 7 days (seconds)

# ---- Encryption (store credentials, payout details) ----
ENCRYPTION_KEY=change-me-32-byte-base64-key

# ---- API ----
API_PORT=4000
API_PREFIX=v1
CORS_ORIGIN=http://localhost:3000

# ---- Web ----
NEXT_PUBLIC_API_URL=http://localhost:4000/v1

# ---- Attribution defaults ----
DEFAULT_COOKIE_WINDOW_DAYS=60
DEFAULT_ATTRIBUTION_MODEL=last_click

# --- Observability (Phase 16) ---
# Optional Sentry error tracking. Leave SENTRY_DSN blank to disable (app runs fine without it).
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
