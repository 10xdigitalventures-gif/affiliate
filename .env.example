# Compatibility reference only; the applications load their own environment
# files. Copy backend/.env.example to backend/.env for local development.
NODE_ENV=development
DATABASE_URL="postgresql://affiliate:REPLACE_WITH_LOCAL_DB_PASSWORD@127.0.0.1:5432/affiliate_platform"
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_LOCAL_REDIS_PASSWORD

JWT_ACCESS_SECRET=REPLACE_WITH_64_CHARACTER_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_CHARACTER_HEX
ENCRYPTION_KEY=REPLACE_WITH_DIFFERENT_64_CHARACTER_HEX
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

API_HOST=127.0.0.1
API_PORT=4000
API_PREFIX=v1
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
ALLOW_BEARER_AUTH=false
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
DEFAULT_COOKIE_WINDOW_DAYS=60

SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
