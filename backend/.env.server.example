# Copy to backend/.env on the Linux server and set every required value.
NODE_ENV=production
API_HOST=0.0.0.0
API_PORT=4100
API_PREFIX=v1

# Managed PostgreSQL is recommended. Require TLS in the provider URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public&sslmode=require

# The production compose file supplies REDIS_HOST/PORT. This password must
# equal REDIS_PASSWORD in the root .env.server file.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_LONG_RANDOM_REDIS_PASSWORD

# Generate three different values: openssl rand -hex 32
JWT_ACCESS_SECRET=REPLACE_WITH_64_CHARACTER_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_CHARACTER_HEX
ENCRYPTION_KEY=REPLACE_WITH_DIFFERENT_64_CHARACTER_HEX
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
EMAIL_LOGIN_CODE_TTL=600

APP_URL=https://affiliate.mentoringhub.online
APP_PUBLIC_URL=https://affiliate.mentoringhub.online
API_PUBLIC_URL=https://affiliate.mentoringhub.online/v1
TRACKING_BASE_URL=https://affiliate.mentoringhub.online/v1
SHOPIFY_APP_URL=https://affiliate.mentoringhub.online
CORS_ORIGIN=https://affiliate.mentoringhub.online,https://web.mentoringhub.online
TRUST_PROXY=linklocal,uniquelocal,loopback
SWAGGER_ENABLED=false
ALLOW_BEARER_AUTH=false

MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=Affiliate Platform <noreply@mentoringhub.online>

SENTRY_DSN=
SENTRY_RELEASE=affiliate-platform@v6
SENTRY_TRACES_SAMPLE_RATE=0.05
OUTBOUND_HTTP_TIMEOUT_MS=10000
GATEWAY_HTTP_TIMEOUT_MS=15000
PAYOUT_HTTP_TIMEOUT_MS=20000
