# MentoringHub production example (Windows + PM2 + Cloudflare Tunnel)
NODE_ENV=production
API_PORT=4100
API_PREFIX=v1
API_HOST=127.0.0.1

# Keep the existing live value when replacing an installation. For a fresh
# setup, replace every placeholder and require TLS for a hosted database.
DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/affiliate_platform?sslmode=require"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Generate three different 64-character hex values for production.
JWT_ACCESS_SECRET=REPLACE_WITH_64_CHARACTER_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_CHARACTER_HEX
ENCRYPTION_KEY=REPLACE_WITH_DIFFERENT_64_CHARACTER_HEX
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
EMAIL_LOGIN_CODE_TTL=600

APP_URL=https://affiliate.mentoringhub.online
APP_PUBLIC_URL=https://affiliate.mentoringhub.online
API_PUBLIC_URL=https://affiliate.mentoringhub.online/v1
TRACKING_BASE_URL=https://affiliate.mentoringhub.online/v1
SHOPIFY_APP_URL=https://affiliate.mentoringhub.online
CORS_ORIGIN=https://affiliate.mentoringhub.online,https://web.mentoringhub.online
TRUST_PROXY=loopback
SWAGGER_ENABLED=false
ALLOW_BEARER_AUTH=false

# Configure SMTP in production so approved affiliates receive their password
# setup link. Leave MAIL_HOST blank only when testing without email delivery.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM="Affiliate Platform <noreply@mentoringhub.online>"
MAIL_ADMIN_EMAIL=
OUTBOUND_HTTP_TIMEOUT_MS=10000
GATEWAY_HTTP_TIMEOUT_MS=15000
PAYOUT_HTTP_TIMEOUT_MS=20000
