# ─── Payout automation (Phase: Real payout automation) ────────────────────────
# Credentials are platform-level (you pay affiliates from your own balance).
# Any method without configured credentials falls back to manual settlement.

# Stripe Connect (method = stripe)
#   Affiliate payout method must store destination.stripeAccountId = acct_...
STRIPE_SECRET_KEY=""

# Wise / TransferWise (method = wise)
#   Affiliate payout method must store destination.wiseRecipientId
WISE_API_TOKEN=""
WISE_PROFILE_ID=""
# Sandbox base: https://api.sandbox.transferwise.tech  | Prod (default): https://api.wise.com
WISE_API_BASE="https://api.wise.com"
