// Unified Affiliate Management Platform - Prisma schema
// Derived from SRS Part 6 (Database Schema & ERD). Multi-tenant SaaS.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------
// Enums
// ------------------------------------------------------------------
enum OrgStatus {
  active
  suspended
  trial
}
enum UserStatus {
  active
  invited
  suspended
}
enum Platform {
  shopify
  woocommerce
  ghl
  custom
}
enum StoreStatus {
  connected
  disconnected
  error
}
enum AffiliateStatus {
  pending
  approved
  suspended
  rejected
}
enum ApplicationStatus {
  pending
  approved
  rejected
}
enum CouponStatus {
  active
  expired
  disabled
}
enum DiscountType {
  percentage
  fixed
}
enum ProductStatus {
  active
  inactive
}
enum RuleScope {
  global
  store
  category
  product
  campaign
  affiliate
}
enum CommissionType {
  percentage
  fixed
  tiered
  recurring
}
enum CommissionStatus {
  pending
  approved
  locked
  payable
  paid
  cancelled
  reversed
}
enum AdjustmentType {
  reversal
  manual
  bonus
  penalty
  partial_refund
}
enum PayoutMethod {
  bank
  wise
  paypal
  stripe
  manual
  crypto
}
enum PayoutStatus {
  requested
  approved
  processing
  paid
  failed
  rejected
}
enum CampaignStatus {
  draft
  active
  ended
}
enum AttributionMethod {
  coupon
  cookie
  lifetime
  manual
}
enum WebhookStatus {
  received
  processing
  processed
  failed
}
enum SyncJobStatus {
  queued
  running
  success
  failed
}
enum NotificationChannel {
  email
  in_app
  webhook
}
enum FraudDecision {
  allow
  review
  block
}
enum FraudReviewStatus {
  open
  approved
  rejected
}
enum PlanInterval {
  month
  year
}
enum SubscriptionStatus {
  active
  trialing
  past_due
  canceled
}
enum LedgerEntryType {
  commission_payable
  commission_adjustment
  payout_reserved
  payout_released
  payout_paid
  reconciliation
}

// ------------------------------------------------------------------
// Tenancy & Identity
// ------------------------------------------------------------------
model Organization {
  id              String    @id @default(uuid())
  name            String
  slug            String    @unique
  plan            String    @default("trial")
  status          OrgStatus @default(trial)
  defaultCurrency String    @default("USD") @db.Char(3)
  settings        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  users        User[]
  roles        Role[]
  stores       Store[]
  affiliates   Affiliate[]
  applications AffiliateApplication[]
  categories   Category[]
  productMaps  ProductMapping[]
  customers    Customer[]
  rules        CommissionRule[]
  payouts      Payout[]
  campaigns    Campaign[]
  notifications Notification[]
  apiKeys      ApiKey[]
  auditLogs    AuditLog[]
  settingsKv   Setting[]
  invitations  Invitation[]
  fraudReviews FraudReview[]
  subscription Subscription?
  domains      Domain[]
  gatewayConfigs   PaymentGatewayConfig[]
  billingCustomers BillingCustomer[]
  billingInvoices  BillingInvoice[]
  ledgerEntries    AffiliateLedgerEntry[]
  balances         AffiliateBalance[]
}

model User {
  id             String     @id @default(uuid())
  organizationId String
  email          String
  passwordHash   String
  fullName       String?
  phoneNumber    String?
  avatarUrl      String?
  status         UserStatus @default(invited)
  emailVerifiedAt DateTime?
  twoFactorEnabled Boolean   @default(false)
  twoFactorSecret        String?
  twoFactorRecoveryCodes String[] @default([])
  ssoProvider    String?
  ssoSubject     String?
  isSuperAdmin   Boolean    @default(false)
  lastLoginAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id])
  roles               UserRole[]
  affiliate           Affiliate?
  auditLogs           AuditLog[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  loginExchangeCodes  LoginExchangeCode[]

  @@unique([organizationId, email])
  @@unique([organizationId, ssoProvider, ssoSubject])
  @@index([organizationId])
}

model Role {
  id             String  @id @default(uuid())
  organizationId String?
  name           String
  isSystem       Boolean @default(false)
  createdAt      DateTime @default(now())

  organization Organization?    @relation(fields: [organizationId], references: [id])
  users        UserRole[]
  permissions  RolePermission[]
  invitations  Invitation[]
}

model Permission {
  id          String @id @default(uuid())
  key         String @unique
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])
  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id])
  role   Role @relation(fields: [roleId], references: [id])
  @@id([userId, roleId])
}

model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  tokenHash         String    @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  userAgent         String?
  ipAddress         String?
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])
  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])
  @@index([userId])
}

model Invitation {
  id              String    @id @default(uuid())
  organizationId  String
  email           String
  roleId          String?
  tokenHash       String    @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  invitedByUserId String?
  createdAt       DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  role         Role?        @relation(fields: [roleId], references: [id])
  @@index([organizationId, email])
}

// ------------------------------------------------------------------
// Stores & Integration
// ------------------------------------------------------------------
model Store {
  id             String      @id @default(uuid())
  organizationId String
  platform       Platform
  name           String
  domain         String
  status         StoreStatus @default(disconnected)
  webhookStatus  String?
  lastSyncedAt   DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization   Organization      @relation(fields: [organizationId], references: [id])
  credentials    StoreCredential?
  products       Product[]
  coupons        Coupon[]
  orders         Order[]
  webhooks       WebhookEvent[]
  syncJobs       SyncJob[]
  affiliateLinks AffiliateLink[]

  @@index([organizationId])
}

model StoreCredential {
  id              String   @id @default(uuid())
  storeId         String   @unique
  accessTokenEnc  Bytes?
  consumerKeyEnc  Bytes?
  consumerSecretEnc Bytes?
  webhookSecretEnc Bytes?
  scopes          String[]
  rotatedAt       DateTime?
  store           Store    @relation(fields: [storeId], references: [id])
}

// ------------------------------------------------------------------
// Affiliates
// ------------------------------------------------------------------
model Affiliate {
  id                     String          @id @default(uuid())
  organizationId         String
  userId                 String?         @unique
  affiliateCode          String
  referralSlug           String
  status                 AffiliateStatus @default(pending)
  defaultCommissionRuleId String?
  parentAffiliateId      String?
  lifetimeEarnings       Decimal         @default(0) @db.Decimal(14, 4)
  availableBalance       Decimal         @default(0) @db.Decimal(14, 4)
  taxInfo                Json?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  organization  Organization    @relation(fields: [organizationId], references: [id])
  user          User?           @relation(fields: [userId], references: [id])
  parent        Affiliate?      @relation("SubAffiliates", fields: [parentAffiliateId], references: [id])
  subAffiliates Affiliate[]     @relation("SubAffiliates")
  links         AffiliateLink[]
  coupons       Coupon[]
  clicks        Click[]
  conversions   Conversion[]
  commissions   Commission[]
  payouts       Payout[]
  payoutMethods PayoutMethodRecord[]
  orders        Order[]
  fraudReviews  FraudReview[]
  ledgerEntries AffiliateLedgerEntry[]
  balances      AffiliateBalance[]

  @@unique([organizationId, affiliateCode])
  @@unique([organizationId, referralSlug])
  @@index([organizationId])
  @@index([parentAffiliateId])
}

model AffiliateApplication {
  id             String            @id @default(uuid())
  organizationId String
  email          String
  payload        Json?
  status         ApplicationStatus @default(pending)
  reviewedBy     String?
  createdAt      DateTime          @default(now())
  organization   Organization      @relation(fields: [organizationId], references: [id])
  @@index([organizationId, status])
}

model AffiliateLink {
  id             String   @id @default(uuid())
  affiliateId    String
  storeId        String?
  campaignId     String?
  destinationUrl String
  shortCode      String   @unique
  clicksCount    BigInt   @default(0)
  createdAt      DateTime @default(now())
  affiliate      Affiliate  @relation(fields: [affiliateId], references: [id])
  store          Store?     @relation(fields: [storeId], references: [id])
  campaign       Campaign?  @relation(fields: [campaignId], references: [id])
  clicks         Click[]
  @@index([affiliateId])
}

// ------------------------------------------------------------------
// Catalog
// ------------------------------------------------------------------
model Category {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  externalId     String?
  organization   Organization @relation(fields: [organizationId], references: [id])
  products       Product[]
}

model Product {
  id         String        @id @default(uuid())
  storeId    String
  externalId String
  sku        String?
  name       String
  categoryId String?
  price      Decimal       @db.Decimal(14, 4)
  status     ProductStatus @default(active)
  createdAt  DateTime      @default(now())
  store      Store         @relation(fields: [storeId], references: [id])
  category   Category?     @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]
  @@unique([storeId, externalId])
  @@index([storeId])
}

model ProductMapping {
  id             String   @id @default(uuid())
  organizationId String
  canonicalName  String
  productIds     String[]
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model Coupon {
  id          String       @id @default(uuid())
  storeId     String
  affiliateId String?
  code        String
  externalId  String?
  discountType DiscountType?
  status      CouponStatus @default(active)
  expiresAt   DateTime?
  createdAt   DateTime     @default(now())
  store       Store        @relation(fields: [storeId], references: [id])
  affiliate   Affiliate?   @relation(fields: [affiliateId], references: [id])
  orders      Order[]
  @@index([storeId])
  @@index([affiliateId])
}

// ------------------------------------------------------------------
// Customers & Orders
// ------------------------------------------------------------------
model Customer {
  id                   String   @id @default(uuid())
  organizationId       String
  email                String?
  phone                String?
  firstAffiliateId     String?
  externalCustomerId   String?
  normalizedEmail      String?
  createdAt            DateTime @default(now())
  organization         Organization @relation(fields: [organizationId], references: [id])
  orders               Order[]
  @@unique([organizationId, normalizedEmail])
  @@unique([organizationId, externalCustomerId])
  @@index([organizationId, email])
}

model Order {
  id              String   @id @default(uuid())
  storeId         String
  externalOrderId String
  customerId      String?
  affiliateId     String?
  couponId        String?
  currency        String   @db.Char(3)
  subtotal        Decimal  @db.Decimal(14, 4)
  tax             Decimal  @default(0) @db.Decimal(14, 4)
  shipping        Decimal  @default(0) @db.Decimal(14, 4)
  total           Decimal  @db.Decimal(14, 4)
  refundAmount    Decimal  @default(0) @db.Decimal(14, 4)
  status          String
  attributionType String?
  trafficChannel  String?
  adNetwork       String?
  adClickId       String?
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  utmContent      String?
  utmTerm         String?
  landingPage     String?  @db.Text
  referrer        String?  @db.Text
  placedAt        DateTime?
  createdAt       DateTime @default(now())

  store       Store       @relation(fields: [storeId], references: [id])
  customer    Customer?   @relation(fields: [customerId], references: [id])
  affiliate   Affiliate?  @relation(fields: [affiliateId], references: [id])
  coupon      Coupon?     @relation(fields: [couponId], references: [id])
  items       OrderItem[]
  commissions Commission[]
  conversions Conversion[]
  fraudReviews FraudReview[]

  @@unique([storeId, externalOrderId])
  @@index([affiliateId])
}

model FraudReview {
  id             String            @id @default(uuid())
  organizationId String
  orderId        String
  affiliateId    String
  score          Int
  decision       FraudDecision
  status         FraudReviewStatus @default(open)
  reasons        Json
  signals        Json?
  notes          String?
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  order        Order        @relation(fields: [orderId], references: [id])
  affiliate    Affiliate    @relation(fields: [affiliateId], references: [id])

  @@unique([orderId, affiliateId])
  @@index([organizationId, status])
  @@index([affiliateId])
}

model OrderItem {
  id               String  @id @default(uuid())
  orderId          String
  productId        String?
  quantity         Int
  unitPrice        Decimal @db.Decimal(14, 4)
  commissionAmount Decimal @default(0) @db.Decimal(14, 4)
  order            Order   @relation(fields: [orderId], references: [id])
  product          Product? @relation(fields: [productId], references: [id])
}

// ------------------------------------------------------------------
// Tracking & Attribution
// ------------------------------------------------------------------
model Click {
  id              String   @id @default(uuid())
  affiliateId     String
  affiliateLinkId String?
  storeId         String?
  ipHash          String?
  userAgent       String?
  deviceType      String?
  landingPage     String?
  utm             Json?
  channel         String?
  adNetwork       String?
  country         String?  @db.Char(2)
  occurredAt      DateTime @default(now())
  affiliate       Affiliate      @relation(fields: [affiliateId], references: [id])
  link            AffiliateLink? @relation(fields: [affiliateLinkId], references: [id])
  conversions     Conversion[]
  @@index([affiliateId, occurredAt])
}

model Conversion {
  id                String            @id @default(uuid())
  clickId           String?
  orderId           String
  affiliateId       String
  attributionMethod AttributionMethod
  createdAt         DateTime          @default(now())
  click             Click?    @relation(fields: [clickId], references: [id])
  order             Order     @relation(fields: [orderId], references: [id])
  affiliate         Affiliate @relation(fields: [affiliateId], references: [id])
  @@unique([orderId, affiliateId])
  @@index([orderId])
}

// ------------------------------------------------------------------
// Commissions & Payouts
// ------------------------------------------------------------------
model CommissionRule {
  id             String         @id @default(uuid())
  organizationId String
  scope          RuleScope
  scopeRefId     String?
  type           CommissionType
  value          Decimal        @db.Decimal(14, 4)
  priority       Int            @default(0)
  stackable      Boolean        @default(false)
  createdAt      DateTime       @default(now())
  organization   Organization   @relation(fields: [organizationId], references: [id])
  commissions    Commission[]
  @@index([organizationId, scope])
}

model Commission {
  id               String           @id @default(uuid())
  orderId          String
  affiliateId      String
  commissionRuleId String?
  amount           Decimal          @db.Decimal(14, 4)
  currency         String           @db.Char(3)
  channel          String?
  attributionType  String?
  status           CommissionStatus @default(pending)
  idempotencyKey   String           @unique
  payoutItemId     String?          @unique
  tier             Int              @default(0)
  sourceCommissionId String?
  approvedAt       DateTime?
  payableAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  order         Order            @relation(fields: [orderId], references: [id])
  affiliate     Affiliate        @relation(fields: [affiliateId], references: [id])
  rule          CommissionRule?  @relation(fields: [commissionRuleId], references: [id])
  source        Commission?      @relation("CommissionOverrides", fields: [sourceCommissionId], references: [id])
  overrides     Commission[]     @relation("CommissionOverrides")
  adjustments   CommissionAdjustment[]
  payoutItem    PayoutItem?      @relation(fields: [payoutItemId], references: [id])
  ledgerEntries AffiliateLedgerEntry[]
  @@index([affiliateId, status])
  @@index([sourceCommissionId])
}

model CommissionAdjustment {
  id             String         @id @default(uuid())
  commissionId   String
  type           AdjustmentType
  delta          Decimal        @db.Decimal(14, 4)
  reason         String?
  createdBy      String?
  idempotencyKey String?        @unique
  metadata       Json?
  createdAt      DateTime       @default(now())
  commission     Commission     @relation(fields: [commissionId], references: [id])
}

model Payout {
  id                   String       @id @default(uuid())
  organizationId       String
  affiliateId          String
  amount               Decimal      @db.Decimal(14, 4)
  currency             String       @db.Char(3)
  method               PayoutMethod
  status               PayoutStatus @default(requested)
  transactionReference String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  organization  Organization          @relation(fields: [organizationId], references: [id])
  affiliate     Affiliate             @relation(fields: [affiliateId], references: [id])
  items         PayoutItem[]
  ledgerEntries AffiliateLedgerEntry[]
  @@index([organizationId, status])
}

model PayoutItem {
  id         String     @id @default(uuid())
  payoutId   String
  amount     Decimal    @db.Decimal(14, 4)
  payout     Payout     @relation(fields: [payoutId], references: [id])
  commission Commission?
}

model PayoutMethodRecord {
  id          String       @id @default(uuid())
  affiliateId String
  method      PayoutMethod
  detailsEnc  Bytes?
  isDefault   Boolean      @default(false)
  affiliate   Affiliate    @relation(fields: [affiliateId], references: [id])
}

// ------------------------------------------------------------------
// Ledger & Balances (v6)
// ------------------------------------------------------------------
model AffiliateLedgerEntry {
  id             String          @id @default(uuid())
  organizationId String
  affiliateId    String
  commissionId   String?
  payoutId       String?
  type           LedgerEntryType
  balanceDelta   Decimal         @db.Decimal(14, 4)
  lifetimeDelta  Decimal         @default(0) @db.Decimal(14, 4)
  currency       String          @db.Char(3)
  idempotencyKey String          @unique
  description    String?
  metadata       Json?
  createdAt      DateTime        @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id])
  affiliate    Affiliate      @relation(fields: [affiliateId], references: [id])
  commission   Commission?    @relation(fields: [commissionId], references: [id])
  payout       Payout?        @relation(fields: [payoutId], references: [id])

  @@index([organizationId, createdAt])
  @@index([affiliateId, currency, createdAt])
}

model AffiliateBalance {
  id             String   @id @default(uuid())
  organizationId String
  affiliateId    String
  currency       String   @db.Char(3)
  available      Decimal  @default(0) @db.Decimal(14, 4)
  lifetime       Decimal  @default(0) @db.Decimal(14, 4)
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  affiliate    Affiliate    @relation(fields: [affiliateId], references: [id])

  @@unique([affiliateId, currency])
  @@index([organizationId, currency])
}

// ------------------------------------------------------------------
// Campaigns, Notifications, Ops
// ------------------------------------------------------------------
model Campaign {
  id             String         @id @default(uuid())
  organizationId String
  name           String
  startsAt       DateTime?
  endsAt         DateTime?
  status         CampaignStatus @default(draft)
  organization   Organization   @relation(fields: [organizationId], references: [id])
  links          AffiliateLink[]
  assets         MarketingAsset[]
}

model MarketingAsset {
  id         String   @id @default(uuid())
  campaignId String
  type       String
  storageKey String
  campaign   Campaign @relation(fields: [campaignId], references: [id])
}

model Notification {
  id              String              @id @default(uuid())
  organizationId  String
  recipientUserId String?
  type            String
  channel         NotificationChannel @default(in_app)
  title           String
  body            String?
  data            Json?
  readAt          DateTime?
  createdAt       DateTime            @default(now())
  organization    Organization        @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([recipientUserId, readAt])
}

model WebhookEvent {
  id                  String        @id @default(uuid())
  storeId             String
  platform            Platform
  topic               String
  idempotencyKey      String        @unique
  payload             Json
  status              WebhookStatus @default(received)
  processingStartedAt DateTime?
  attempts            Int           @default(0)
  createdAt           DateTime      @default(now())
  store               Store         @relation(fields: [storeId], references: [id])
  @@index([storeId, topic])
}

model SyncJob {
  id          String        @id @default(uuid())
  storeId     String
  jobType     String
  status      SyncJobStatus @default(queued)
  nextRetryAt DateTime?
  createdAt   DateTime      @default(now())
  store       Store         @relation(fields: [storeId], references: [id])
}

model ApiKey {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  keyHash        String
  prefix         String?
  scopes         String[]
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String
  userId         String?
  action         String
  resourceType   String?
  resourceId     String?
  oldValue       Json?
  newValue       Json?
  ipAddress      String?
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User?        @relation(fields: [userId], references: [id])
  @@index([organizationId, createdAt])
}

model Setting {
  id             String   @id @default(uuid())
  organizationId String
  key            String
  value          Json
  organization   Organization @relation(fields: [organizationId], references: [id])
  @@unique([organizationId, key])
}

model Plan {
  id            String       @id @default(uuid())
  key           String       @unique
  name          String
  description   String?
  priceCents    Int          @default(0)
  currency      String       @default("USD") @db.Char(3)
  interval      PlanInterval @default(month)
  features      Json         @default("{}")
  limits        Json         @default("{}")
  isPublic      Boolean      @default(true)
  isArchived    Boolean      @default(false)
  sortOrder     Int          @default(0)
  trialDays     Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  subscriptions Subscription[]
}

model Subscription {
  id               String             @id @default(uuid())
  organizationId   String             @unique
  planId           String
  status           SubscriptionStatus @default(trialing)
  currentPeriodEnd DateTime?
  trialEndsAt      DateTime?
  seats            Int                @default(0)
  overrides        Json?
  externalRef      String?
  billingLockAt    DateTime?
  billingLockToken String?
  pastDueSince     DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan             Plan               @relation(fields: [planId], references: [id])
  @@index([planId])
}

enum DomainStatus {
  pending
  verifying
  active
  failed
}

enum DomainPurpose {
  login
  tracking
}

model Domain {
  id                String        @id @default(uuid())
  organizationId    String
  hostname          String        @unique
  status            DomainStatus  @default(pending)
  purpose           DomainPurpose @default(login)
  verificationToken String
  isPrimary         Boolean       @default(false)
  lastCheckedAt     DateTime?
  verifiedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

enum GatewayProvider {
  whop
  swich
}
enum GatewayScope {
  platform
  tenant
}
enum BillingInvoiceStatus {
  draft
  open
  paid
  void
  uncollectible
  refunded
}
enum BillingEventStatus {
  received
  processed
  failed
  ignored
}

model PaymentGatewayConfig {
  id               String          @id @default(uuid())
  scope            GatewayScope    @default(platform)
  organizationId   String?
  provider         GatewayProvider
  label            String?
  companyId        String?
  apiKeyEnc        Bytes?
  webhookSecretEnc Bytes?
  isLive           Boolean         @default(false)
  isActive         Boolean         @default(true)
  isDefault        Boolean         @default(false)
  taxEnabled       Boolean         @default(false)
  taxPercent       Float           @default(0)
  taxLabel         String?         @default("Tax")
  taxInclusive     Boolean         @default(false)
  metadata         Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  organization     Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customers        BillingCustomer[]
  invoices         BillingInvoice[]
  @@index([scope, provider])
  @@index([organizationId])
}

model BillingCustomer {
  id                     String          @id @default(uuid())
  organizationId         String
  configId               String
  provider               GatewayProvider
  providerCustomerId     String?
  providerMemberId       String?
  defaultPaymentMethodId String?
  cardBrand              String?
  cardLast4              String?
  cardExpMonth           Int?
  cardExpYear            Int?
  email                  String?
  metadata               Json?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  organization           Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  config                 PaymentGatewayConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  invoices               BillingInvoice[]
  @@unique([organizationId, configId])
  @@index([provider])
}

model BillingInvoice {
  id                String               @id @default(uuid())
  organizationId    String
  configId          String
  customerId        String?
  provider          GatewayProvider
  providerInvoiceId String?
  providerPaymentId String?
  number            String?
  status            BillingInvoiceStatus @default(draft)
  currency          String               @default("USD") @db.Char(3)
  subtotalCents     Int                  @default(0)
  taxCents          Int                  @default(0)
  totalCents        Int                  @default(0)
  lineItems         Json                 @default("[]")
  hostedUrl         String?
  pdfUrl            String?
  dueAt             DateTime?
  paidAt            DateTime?
  periodStart       DateTime?
  periodEnd         DateTime?
  idempotencyKey    String?              @unique
  metadata          Json?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  config            PaymentGatewayConfig @relation(fields: [configId], references: [id])
  customer          BillingCustomer?     @relation(fields: [customerId], references: [id])
  @@index([organizationId])
  @@index([organizationId, periodStart])
  @@index([provider, status])
}

model GatewayEvent {
  id          String             @id @default(uuid())
  provider    GatewayProvider
  eventId     String
  type        String
  status      BillingEventStatus @default(received)
  payload     Json
  error       String?
  receivedAt  DateTime           @default(now())
  processedAt DateTime?
  @@unique([provider, eventId])
  @@index([type])
}

model SsoLoginState {
  id             String    @id @default(uuid())
  organizationId String
  stateHash      String    @unique
  codeVerifier   String
  nonce          String
  redirectPath   String    @default("/")
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())
  @@index([organizationId, expiresAt])
}

model LoginExchangeCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model ShopifyOAuthState {
  id             String    @id @default(uuid())
  organizationId String
  stateHash      String    @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())
  @@index([organizationId, expiresAt])
}

model ShopifyStaffIdentity {
  id             String   @id @default(uuid())
  organizationId String
  storeId        String
  userId         String
  shopifyUserId  String
  createdAt      DateTime @default(now())
  lastSeenAt     DateTime @default(now())
  @@unique([storeId, shopifyUserId])
  @@unique([storeId, userId])
  @@index([organizationId])
}
