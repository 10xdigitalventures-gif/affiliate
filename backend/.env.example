# Local development only. Production deployers preserve the live .env and
# refuse placeholder secrets. Never commit backend/.env.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
API_PREFIX=v1

DATABASE_URL="postgresql://affiliate:LOCAL_PASSWORD@127.0.0.1:5432/affiliate_platform"
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=LOCAL_REDIS_PASSWORD

# Generate three different values with: openssl rand -hex 32
JWT_ACCESS_SECRET=REPLACE_WITH_64_CHARACTER_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_CHARACTER_HEX
ENCRYPTION_KEY=REPLACE_WITH_DIFFERENT_64_CHARACTER_HEX
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
PASSWORD_RESET_TTL=3600
INVITE_TTL=604800
EMAIL_LOGIN_CODE_TTL=600

APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
TRUST_PROXY=false
COOKIE_SECURE=false
SWAGGER_ENABLED=true
ALLOW_BEARER_AUTH=false
RATE_LIMIT_MAX=120
RATE_LIMIT_TTL_MS=60000
DEFAULT_COOKIE_WINDOW_DAYS=60

# Optional email. Empty MAIL_HOST disables delivery for local development.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM="Affiliate Platform <noreply@example.com>"
MAIL_ADMIN_EMAIL=

# Optional observability.
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0

# Optional commerce integrations.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_APP_URL=
SHOPIFY_SCOPES=read_products,read_orders
STRIPE_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
WISE_API_TOKEN=
WISE_PROFILE_ID=

# Network egress remains public-only unless deliberately enabled for a trusted
# private integration endpoint.
ALLOW_PRIVATE_OUTBOUND=false
OUTBOUND_HTTP_TIMEOUT_MS=10000
GATEWAY_HTTP_TIMEOUT_MS=15000
PAYOUT_HTTP_TIMEOUT_MS=20000
